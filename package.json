{
  "name": "allgather",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Tasks, Git history, and agent access for one owner",
  "scripts": {
    "server": "bun --no-env-file server/cli.ts",
    "cli": "bun --no-env-file cli/index.ts",
    "build": "bun scripts/compile.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "check": "biome check shared server cli web scripts skills tests",
    "postinstall": "$npm_execpath node_modules/bun2nix/index.ts -o bun.nix"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@formkit/auto-animate": "0.10.0",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@node-oauth/oauth2-server": "5.3.0",
    "@simplewebauthn/browser": "14.0.0",
    "@simplewebauthn/server": "14.0.3",
    "@tanstack/react-query": "5.103.1",
    "@tanstack/virtual-core": "3.17.11",
    "@zip.js/zip.js": "2.23.0",
    "ajv": "8.20.0",
    "hono": "4.13.8",
    "i18next": "26.4.2",
    "markdown-it": "15.0.2",
    "nanoid": "6.0.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-i18next": "17.0.15",
    "shiki": "4.4.3",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "bun-plugin-tailwind": "0.1.2",
    "bun2nix": "2.1.2",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2"
  },
  "overrides": {
    "bun": "npm:empty-npm-package@1.0.0"
  },
  "engines": {
    "bun": ">=1.4.2"
  }
}
