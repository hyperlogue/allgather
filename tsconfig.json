{
  "compilerOptions": {
    "target": "ESNext", "module": "ESNext", "moduleResolution": "bundler",
    "moduleDetection": "force", "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true, "noEmit": true, "strict": true,
    "skipLibCheck": true, "esModuleInterop": true, "resolveJsonModule": true,
    "noUnusedLocals": true, "noUnusedParameters": true,
    "isolatedModules": true, "jsx": "react-jsx",
    "lib": ["ESNext", "DOM", "DOM.Iterable"], "types": ["bun"]
  },
  "include": ["shared", "server", "cli", "web", "scripts", ".agents/skills/*/scripts/**/*.ts", "tests"]
}
